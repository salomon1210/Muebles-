---
import '../styles/global.css';
import { site, whatsappLink } from '../config';
import WishlistCounter from '../components/WishlistCounter.tsx';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image = '/og-default.svg' } = Astro.props;
const fullTitle = title ? `${title} — ${site.nombre}` : `${site.nombre} — ${site.tagline}`;
const desc = description ?? site.descripcion;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const nav = [
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/como-funciona', label: 'Cómo funciona' },
  { href: '/showroom', label: 'Showroom' },
  { href: '/faq', label: 'FAQ' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#16130f" />
    <slot name="head" />
  </head>
  <body>
    <!-- Barra superior -->
    <header class="sticky top-0 z-40 bg-crema-100/90 backdrop-blur border-b border-noir/10">
      <div class="container-px mx-auto max-w-7xl flex items-center justify-between h-16">
        <a href="/" class="font-display text-2xl tracking-tight leading-none">
          {site.nombre}<span class="text-oro">.</span>
        </a>
        <nav class="hidden md:flex items-center gap-8">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={['text-sm uppercase tracking-widest link-underline', path.startsWith(n.href) ? 'text-oro' : 'text-noir/80 hover:text-noir']}
            >
              {n.label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-5">
          <WishlistCounter client:load />
          <button
            id="menu-toggle"
            class="md:hidden text-noir"
            aria-label="Abrir menú"
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>
      <!-- Menú mobile -->
      <nav id="mobile-menu" class="md:hidden hidden border-t border-noir/10 bg-crema-100">
        <div class="container-px mx-auto max-w-7xl py-4 flex flex-col gap-3">
          {nav.map((n) => (
            <a href={n.href} class="text-sm uppercase tracking-widest py-1 text-noir/80">{n.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-noir text-crema-200 mt-24">
      <div class="container-px mx-auto max-w-7xl py-16 grid gap-12 md:grid-cols-3">
        <div>
          <p class="font-display text-3xl">{site.nombre}<span class="text-oro">.</span></p>
          <p class="mt-4 text-sm text-crema-200/70 max-w-xs leading-relaxed">{site.claim}</p>
        </div>
        <div class="text-sm">
          <p class="eyebrow mb-4">Navegación</p>
          <ul class="space-y-2 text-crema-200/80">
            <li><a class="hover:text-oro" href="/catalogo">Catálogo</a></li>
            <li><a class="hover:text-oro" href="/como-funciona">Cómo funciona</a></li>
            <li><a class="hover:text-oro" href="/showroom">Showroom</a></li>
            <li><a class="hover:text-oro" href="/faq">Preguntas frecuentes</a></li>
            <li><a class="hover:text-oro" href="/mi-lista">Mi lista</a></li>
          </ul>
        </div>
        <div class="text-sm">
          <p class="eyebrow mb-4">Contacto</p>
          <a
            href={whatsappLink('Hola, vengo de la web de ' + site.nombre + ' y quiero hacer una consulta.')}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-crema-100 hover:text-oro"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.477-.917zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            {site.whatsappDisplay}
          </a>
          <p class="mt-4 text-crema-200/70">{site.email}</p>
          <p class="mt-1 text-crema-200/70">{site.ubicacion}</p>
        </div>
      </div>
      <div class="border-t border-crema-200/10">
        <div class="container-px mx-auto max-w-7xl py-6 text-xs text-crema-200/50 flex flex-col sm:flex-row gap-2 justify-between">
          <p>© {new Date().getFullYear()} {site.nombre}. Todos los derechos reservados.</p>
          <p>Importación premium · Sin precio argentino.</p>
        </div>
      </div>
    </footer>

    <!-- Botón flotante de WhatsApp -->
    <a
      href={whatsappLink('Hola, vengo de la web de ' + site.nombre + ' y quiero hacer una consulta.')}
      target="_blank"
      rel="noopener"
      aria-label="Escribinos por WhatsApp"
      class="fixed bottom-5 right-5 z-50 w-14 h-14 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-lg hover:scale-105 transition-transform"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.477-.917zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
    </a>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
  </body>
</html>
