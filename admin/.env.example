# Panel interno — copiá a ".env" y completá. NO subir ".env" a git.
# Estas dos salen de Supabase → Project Settings → API.
# Es seguro que la ANON key viaje al navegador: sola no da acceso a nada
# (RLS exige login). La service_role key NUNCA va acá.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nombre del bucket de Storage para las fotos (creado en Supabase).
VITE_STORAGE_BUCKET=productos
